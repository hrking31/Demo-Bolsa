# Copia este archivo como .env.local (no se sube a git) y completa UNA opción.
# Sin ninguna, la app muestra datos de ejemplo.

# Opción recomendada: dirección del intermediario de Cloudflare (carpeta worker/).
# La clave queda guardada como secreto en Cloudflare y no llega al navegador.
VITE_API_PROXY_URL=

# Alternativa para desarrollo: clave gratuita de https://twelvedata.com/
# (Dashboard → API Keys). Ojo: queda incluida en el código del navegador.
VITE_TWELVE_DATA_API_KEY=
